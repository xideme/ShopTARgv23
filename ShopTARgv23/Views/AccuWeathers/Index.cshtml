@model ShopTARgv23.Models.AccuWeathers.AccuWeatherSearchViewModel

<h1>Search city</h1>


<div class="container">
    <form method="post">
        <div class="container">
            <div class="form-group col-md-offset-3 col-md-5">
                <h2>Search the city forecast</h2>
                <label asp-for="CityName"></label>
                <label asp-for="CityCode" class="form-control-lg"></label>
                <span asp-validation-for="CityName" class="text-danger"></span>
            </div>
        </div>
        <div class="container">
            <div class="form btn-group col-md-offset-3 col-md-3">
                <button asp-controller="accuWeathers" asp-action="searchCity" type="submit" class="btn btn-primary" value="Search" />

            </div>
         </div>
    </form>
</div>
